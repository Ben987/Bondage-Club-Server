# App settings
DATABASE_NAME=BondageClubDatabase
DATABASE_USER=admin
DATABASE_PASS=password
DATABASE_HOST=db
DATABASE_PORT=27017
DATABASE_WEBADMIN=true
DATABASE_URL=mongodb://${DATABASE_USER}:${DATABASE_PASS}@${DATABASE_HOST}:${DATABASE_PORT}
PORT=4288
NEW_RELIC_LICENSE_KEY=
EMAIL_ADMIN=
EMAIL_PASSWORD=
LOGIN_FAILURE_LIMIT=
LOGIN_FAILURE_ACCOUNT_LIMIT=
IP_CONNECTION_LIMIT=
IP_CONNECTION_RATE_LIMIT=
CLIENT_MESSAGE_RATE_LIMIT=
LOGIN_CONCURRENCY=
# Connections an IP address can open at once before IP_CONNECTION_RATE_LIMIT applies (default 10)
IP_CONNECTION_BURST=
# Messages a client can send at once before CLIENT_MESSAGE_RATE_LIMIT applies (default 3x the rate)
CLIENT_MESSAGE_BURST=
# Multiplies the rate limits of the expensive events, ChatRoomSearch and AccountQuery (default 1)
EVENT_RATE_LIMIT_SCALE=
# Header holding the real client IP, set by a trusted proxy (default x-forwarded-for)
# Set it to an empty value when the server isn't behind a proxy, or clients can spoof their IP
#IP_CONNECTION_PROXY_HEADER=
# Heap usage (bytes) that triggers a clean reboot (default 90% of the V8 heap limit)
MAX_HEAP_USAGE=
# Milliseconds between SIGTERM and the final save & exit (default 22000, Heroku kills the process after 30s)
SHUTDOWN_DELAY=
# Creates the AccountName (unique), MemberNumber and Email indexes at startup if they don't exist (default false)
DATABASE_CREATE_INDEXES=
# Maximum number of MongoDB connections (default 50)
DATABASE_POOL_SIZE=

# Database settings
MONGO_INITDB_ROOT_USERNAME=${DATABASE_USER}
MONGO_INITDB_ROOT_PASSWORD=${DATABASE_PASS}
MONGO_INITDB_DATABASE=${DATABASE_NAME}
ME_CONFIG_MONGODB_ADMINUSERNAME=${MONGO_INITDB_ROOT_USERNAME}
ME_CONFIG_MONGODB_ADMINPASSWORD=${MONGO_INITDB_ROOT_PASSWORD}
ME_CONFIG_MONGODB_SERVER=${DATABASE_HOST}
ME_CONFIG_MONGODB_PORT=${DATABASE_PORT}
ME_CONFIG_MONGODB_ENABLE_ADMIN=${DATABASE_WEBADMIN}
